# ==============================================================================
# AgriSense .gitignore
# ==============================================================================

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Sensitive Environment Variables & API Keys
.env
.env.*
!.env.example

# Node / Frontend Dependencies & Production Builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
*.log

# OS & Editor generated files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Local scratch and temporary files
scratch/
*.tmp
