# AgriSense Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# OpenWeatherMap API Key (Free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key

# Groq Cloud API Key (Free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Google Gemini API Key (Free tier at https://aistudio.google.com)
Gemini_API_KEY=your_gemini_api_key

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key
